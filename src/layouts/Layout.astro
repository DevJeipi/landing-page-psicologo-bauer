---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Psicólogo Bauer | Terapia Presencial em Hamburgo Velho & Online",
  description = "Mais de 28 anos de prática clínica e +6.000 mentes autorrealizadas. Atendimento presencial na Zape Reequilíbrio (Hamburgo Velho - NH) e online para todo o Brasil. Apresentador do Podcast Inspire."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c2417" />

    <!-- Open Graph / Meta Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Google Fonts: Inter & EB Garamond -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..700;1,400..700&family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-white text-neutral-900 selection:bg-forest-900 selection:text-accent-lime font-sans">
    <slot />
  </body>
</html>
