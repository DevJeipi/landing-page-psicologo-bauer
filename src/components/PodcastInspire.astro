---
import { Mic, Play, Radio, Headphones, Volume2, MessageCircle } from 'lucide-astro';

const podcastWhatsappMsg = encodeURIComponent("Olá, Bauer! Ouço o podcast Inspire e gostaria de iniciar meu processo de psicoterapia com você. Como funcionam os próximos horários?");
const podcastWhatsappUrl = `https://wa.me/5551999999999?text=${podcastWhatsappMsg}`;

const episodes = [
  {
    number: "#48",
    title: "O Silêncio como Remédio: Como Acalmar a Mente sem Fugir da Realidade",
    duration: "42 min",
    category: "Serenidade & Calma",
    description: "Reflexões sobre como encontrar ilhas de silêncio no cotidiano barulhento e restabelecer o equilíbrio do sistema nervoso."
  },
  {
    number: "#41",
    title: "A Ilusão do Controle: Aprendendo a Soltar o que Não Depende de Você",
    duration: "38 min",
    category: "Gestão Emocional",
    description: "Por que tentamos controlar tudo e como a aceitação consciente liberta uma quantidade imensa de energia vital."
  },
  {
    number: "#35",
    title: "Autorrealização vs. Sucesso Externo: Onde Fica a Sua Verdade?",
    duration: "45 min",
    category: "Propósito de Vida",
    description: "Uma análise profunda de 28 anos de consultório sobre o que realmente preenche a alma e gera satisfação duradoura."
  },
  {
    number: "#29",
    title: "Ansiedade e os Ritmos da Natureza: Respeitando seu Próprio Tempo",
    duration: "36 min",
    category: "Natureza & Saúde Mental",
    description: "Como a pressa artificial do mundo moderno desconecta o ser humano do seu ritmo biológico e psíquico natural."
  }
];
---

<section id="podcast" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
  
  <div class="bg-forest-900 text-white rounded-[2.5rem] p-8 sm:p-12 lg:p-16 border border-forest-800 relative overflow-hidden shadow-glow-forest">
    
    <!-- Glow effects -->
    <div class="absolute -top-32 -left-32 w-80 h-80 bg-accent-lime/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-80 h-80 bg-sage-400/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10">
      
      <!-- Section Header -->
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-14">
        <div class="space-y-4 max-w-2xl">
          <div class="inline-flex items-center gap-2 bg-forest-800 text-accent-lime text-xs font-semibold px-3.5 py-1.5 rounded-full uppercase tracking-wider border border-forest-700">
            <Mic class="w-3.5 h-3.5" />
            <span>Conteúdo em Áudio • Apresentado por Bauer</span>
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-white font-serif leading-tight">
            Podcast <span class="text-accent-lime italic">Inspire</span>: reflexões para desacelerar a sua mente.
          </h2>

          <p class="text-neutral-300 text-base leading-relaxed">
            Episódios semanais com conversas profundas sobre autoconhecimento, inteligência emocional, psicologia e conexão com a natureza.
          </p>
        </div>

        <!-- Platform Badges -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="bg-forest-950/80 border border-forest-700/80 px-4 py-2.5 rounded-2xl flex items-center gap-2 text-xs font-medium text-neutral-200">
            <Headphones class="w-4 h-4 text-accent-lime" />
            <span>Disponível no Spotify</span>
          </div>
          <div class="bg-forest-950/80 border border-forest-700/80 px-4 py-2.5 rounded-2xl flex items-center gap-2 text-xs font-medium text-neutral-200">
            <Radio class="w-4 h-4 text-accent-lime" />
            <span>Apple Podcasts</span>
          </div>
        </div>
      </div>

      <!-- Episodes Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {episodes.map((ep) => (
          <div class="bg-forest-950/70 hover:bg-forest-950/90 rounded-[2rem] p-6 sm:p-7 border border-forest-800/90 hover:border-forest-700 transition-all duration-300 group flex flex-col justify-between">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="bg-forest-800 text-accent-lime text-xs font-bold px-2.5 py-1 rounded-lg">
                  {ep.number}
                </span>
                <div class="flex items-center gap-2 text-xs text-neutral-400">
                  <span class="text-accent-lime font-medium">{ep.category}</span>
                  <span>•</span>
                  <span>{ep.duration}</span>
                </div>
              </div>

              <h3 class="text-lg sm:text-xl font-semibold text-white group-hover:text-accent-lime transition-colors leading-snug">
                {ep.title}
              </h3>

              <p class="text-sm text-neutral-400 leading-relaxed">
                {ep.description}
              </p>
            </div>

            <div class="pt-6 mt-6 border-t border-forest-800/80 flex items-center justify-between">
              <!-- Animated mini waveform -->
              <div class="flex items-end gap-1 h-4">
                <span class="w-0.5 bg-accent-lime/60 rounded-full h-2"></span>
                <span class="w-0.5 bg-accent-lime/90 rounded-full h-4"></span>
                <span class="w-0.5 bg-accent-lime rounded-full h-3"></span>
                <span class="w-0.5 bg-accent-lime/70 rounded-full h-2"></span>
                <span class="w-0.5 bg-accent-lime/40 rounded-full h-1"></span>
              </div>

              <span class="text-xs font-semibold text-neutral-300 group-hover:text-accent-lime flex items-center gap-1.5 transition-colors">
                <Play class="w-3.5 h-3.5 fill-current" />
                <span>Ouvir Episódio</span>
              </span>
            </div>
          </div>
        ))}
      </div>

      <!-- Podcast Bottom Callout with Direct WhatsApp -->
      <div class="mt-10 bg-forest-950 rounded-2xl p-6 sm:p-8 border border-forest-800 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-full bg-accent-lime/20 text-accent-lime flex items-center justify-center flex-shrink-0">
            <Volume2 class="w-6 h-6" />
          </div>
          <div>
            <p class="text-base font-semibold text-white">Gostou das reflexões do Podcast Inspire?</p>
            <p class="text-xs sm:text-sm text-neutral-400 mt-0.5">Inicie seu processo terapêutico individual diretamente com o Psicólogo Bauer.</p>
          </div>
        </div>

        <a 
          href={podcastWhatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-accent-lime hover:bg-accent-lime-hover text-forest-950 font-semibold text-sm px-6 py-3.5 rounded-full whitespace-nowrap transition-all shadow-glow-lime flex items-center gap-2"
        >
          <MessageCircle class="w-4 h-4 text-forest-950" />
          <span>Falar no WhatsApp</span>
        </a>
      </div>

    </div>

  </div>

</section>
