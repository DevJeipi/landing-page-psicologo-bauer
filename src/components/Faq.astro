---
import { ChevronDown, Sparkles } from 'lucide-astro';
import { faqs } from '../data/faqs';
---

<section id="faq" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 border-t border-neutral-100">
  
  <div class="text-center space-y-4 mb-16">
    <div class="inline-flex items-center gap-2 bg-sage-100 text-forest-800 text-xs font-semibold px-3.5 py-1.5 rounded-full uppercase tracking-wider">
      <Sparkles class="w-3.5 h-3.5" />
      <span>Tire suas Dúvidas</span>
    </div>
    
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-forest-950 font-serif leading-tight">
      Perguntas Frequentes
    </h2>
    
    <p class="text-base text-neutral-600 max-w-xl mx-auto">
      Esclareça os principais pontos sobre as sessões, formatos e o processo terapêutico.
    </p>
  </div>

  <div class="space-y-4">
    {faqs.map((faq) => (
      <details class="group bg-neutral-50 hover:bg-forest-50/50 p-6 sm:p-7 rounded-[1.75rem] border border-neutral-200/80 transition-all duration-200 cursor-pointer">
        <summary class="flex justify-between items-center font-medium list-none text-base sm:text-lg text-forest-950 gap-4">
          <span class="font-medium group-open:text-forest-800 group-open:font-semibold transition-colors">
            {faq.question}
          </span>
          <div class="w-8 h-8 rounded-full bg-white border border-neutral-200 flex items-center justify-center flex-shrink-0 group-open:bg-forest-900 group-open:text-accent-lime group-open:border-forest-900 transition-all">
            <ChevronDown class="w-4 h-4 transition-transform duration-300 group-open:rotate-180" />
          </div>
        </summary>
        <p class="text-neutral-600 mt-4 text-sm sm:text-base leading-relaxed border-t border-neutral-200/60 pt-4">
          {faq.answer}
        </p>
      </details>
    ))}
  </div>

</section>
