<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="bg-forest-50/80 border border-forest-100/90 rounded-3xl p-6 sm:p-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 items-center">
      
      <!-- Metric 1 -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left space-y-1">
        <div class="flex items-center gap-2">
          <span class="text-3xl sm:text-4xl font-bold font-serif text-forest-900 tracking-tight">Desde 1998</span>
        </div>
        <p class="text-xs sm:text-sm font-medium text-forest-700">De Prática Clínica & Escuta</p>
        <p class="text-[11px] text-neutral-500">Trajetória sólida e acolhedora</p>
      </div>

      <!-- Metric 2 -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left space-y-1 md:border-l md:border-forest-200 md:pl-8">
        <div class="flex items-center gap-2">
          <span class="text-3xl sm:text-4xl font-bold font-serif text-forest-900 tracking-tight">+8.000</span>
        </div>
        <p class="text-xs sm:text-sm font-medium text-forest-700">Mentes Autorrealizadas</p>
        <p class="text-[11px] text-neutral-500">Vidas e histórias transformadas</p>
      </div>

      <!-- Metric 3 -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left space-y-1 md:border-l md:border-forest-200 md:pl-8">
        <div class="flex items-center gap-2">
          <span class="text-2xl sm:text-3xl font-bold font-serif text-forest-900 tracking-tight">Zape & Online</span>
        </div>
        <p class="text-xs sm:text-sm font-medium text-forest-700">Presencial & Remoto</p>
        <p class="text-[11px] text-neutral-500">Novo Hamburgo ou no seu espaço</p>
      </div>

      <!-- Metric 4 -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left space-y-1 md:border-l md:border-forest-200 md:pl-8">
        <div class="flex items-center gap-2">
          <span class="text-3xl sm:text-4xl font-bold font-serif text-forest-900 tracking-tight">100%</span>
        </div>
        <p class="text-xs sm:text-sm font-medium text-forest-700">Sigilo & Ética</p>
        <p class="text-[11px] text-neutral-500">Conforme código do CFP</p>
      </div>

    </div>
  </div>
</section>
