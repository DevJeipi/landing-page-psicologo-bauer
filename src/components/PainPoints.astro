---
import { Brain, BatteryCharging, Compass, HeartCrack, HelpCircle, ArrowDown, Sparkles } from 'lucide-astro';

const pains = [
  {
    icon: Brain,
    title: "Mente Acelerada e Pensamento Excessivo",
    description: "Você deita na cama para descansar, mas o cérebro continua repassando preocupações, cenários futuros e cobranças. A sensação de que nunca há paz genuína.",
    badge: "Sobrecarga Mental"
  },
  {
    icon: BatteryCharging,
    title: "Cansaço Emocional e Autocobrança",
    description: "A obrigação de dar conta de tudo e parecer sempre forte para os outros. Por dentro, um esgotamento invisível que café ou fins de semana não conseguem curar.",
    badge: "Esgotamento"
  },
  {
    icon: Compass,
    title: "Sensação de Vazio ou Falta de Rumo",
    description: "Mesmo com conquistas materiais ou profissionais, bate uma sensação de piloto automático: 'onde foi parar a minha motivação e a minha alegria de viver?'.",
    badge: "Busca de Sentido"
  },
  {
    icon: HeartCrack,
    title: "Dificuldade de Dizer 'Não' e Impor Limites",
    description: "Cuidar de todo mundo e se colocar sempre em último lugar. O receio do conflito ou de desagradar acaba custando a sua própria saúde emocional.",
    badge: "Relações & Limites"
  }
];
---

<section id="dores" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
  
  <!-- Section Editorial Header -->
  <div class="max-w-3xl mx-auto text-center space-y-4 mb-16">
    <div class="inline-flex items-center gap-2 bg-sage-100 text-forest-800 text-xs font-semibold px-3.5 py-1.5 rounded-full uppercase tracking-wider">
      <Sparkles class="w-3.5 h-3.5" />
      <span>Momento de Reflexão</span>
    </div>
    
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-forest-950 font-serif leading-tight">
      Você sente que está vivendo no <span class="italic text-forest-700">piloto automático</span>, carregando um peso invisível?
    </h2>
    
    <p class="text-base sm:text-lg text-neutral-600 font-normal leading-relaxed">
      A maioria das pessoas que chegam ao consultório do Bauer acreditava que precisava "aguentar firme" sozinha. Mas a exaustão emocional não é fraqueza — é um sinal de que algo essencial precisa de escuta e cuidado.
    </p>
  </div>

  <!-- Pain Points Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
    {pains.map((item, index) => {
      const IconComponent = item.icon;
      return (
        <div class="bg-neutral-50/90 hover:bg-white rounded-[2rem] p-8 border border-neutral-200/80 hover:border-forest-200 transition-all duration-300 hover:shadow-card-soft group relative overflow-hidden">
          
          <div class="flex items-start justify-between mb-6">
            <div class="w-13 h-13 rounded-2xl bg-forest-900 text-accent-lime p-3 flex items-center justify-center shadow-md group-hover:scale-105 transition-transform">
              <IconComponent class="w-6 h-6" />
            </div>
            <span class="text-xs font-semibold text-forest-700 bg-forest-100/70 px-3 py-1 rounded-full">
              {item.badge}
            </span>
          </div>

          <h3 class="text-xl font-semibold text-forest-950 mb-3 group-hover:text-forest-800 transition-colors">
            {item.title}
          </h3>

          <p class="text-sm sm:text-base text-neutral-600 leading-relaxed">
            {item.description}
          </p>

        </div>
      );
    })}
  </div>

  <!-- Gentle Transition Banner to Solution -->
  <div class="mt-12 bg-forest-900 text-white rounded-[2rem] p-8 sm:p-10 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6 border border-forest-800 shadow-glow-forest">
    <div class="space-y-2 max-w-2xl">
      <h3 class="text-xl sm:text-2xl font-serif font-medium text-white">
        Você não precisa desatar todos esses nós sozinho.
      </h3>
      <p class="text-sm text-neutral-300">
        Com o acompanhamento terapêutico adequado, é possível desacelerar, compreender a origem dessas dores e construir um caminho sólido de reequilíbrio.
      </p>
    </div>
    
    <a 
      href="#agendamento" 
      class="whitespace-nowrap bg-accent-lime hover:bg-accent-lime-hover text-forest-950 text-sm font-semibold px-6 py-3.5 rounded-full transition-transform hover:scale-105 shadow-sm"
    >
      Dar o primeiro passo
    </a>
  </div>

</section>
