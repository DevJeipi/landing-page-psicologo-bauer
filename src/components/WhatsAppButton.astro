---
import { MessageCircle } from 'lucide-astro';
import { whatsappUrl } from '../data/site';

const whatsappUrlHref = whatsappUrl("Olá, Psicólogo Bauer! Gostaria de tirar algumas dúvidas e saber sobre horários disponíveis para atendimento.");
---

<div class="fixed bottom-6 right-6 z-50 flex items-center gap-3">
  <!-- Tooltip Bubble -->
  <a 
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="hidden md:flex items-center bg-white text-forest-950 text-xs font-semibold px-4 py-2.5 rounded-full shadow-lg border border-neutral-200 gap-2 hover:bg-neutral-50 transition-all cursor-pointer"
  >
    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
    <span>Fale com o Bauer</span>
  </a>

  <!-- Main Floating Action Button -->
  <a 
    href={whatsappUrl} 
    target="_blank" 
    rel="noopener noreferrer" 
    aria-label="Abrir conversa no WhatsApp com Psicólogo Bauer"
    class="relative w-14 h-14 bg-emerald-600 hover:bg-emerald-500 text-white rounded-full flex items-center justify-center shadow-2xl transition-all duration-300 transform hover:scale-110 active:scale-95 group"
  >
    <!-- Radar ping effect -->
    <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-30 animate-ping"></span>
    
    <MessageCircle class="w-7 h-7 relative z-10 text-white transition-transform group-hover:scale-110" />
  </a>
</div>
