---
import { Send, Menu, X } from 'lucide-astro';

const navLinks = [
  { href: "#sobre", label: "Sobre" },
  { href: "#modalidades", label: "Atendimentos" },
  { href: "#depoimentos", label: "Depoimentos" },
  { href: "#podcast", label: "Podcast" },
  { href: "#faq", label: "Dúvidas" },
];
---

<header class="sticky top-0 z-50 w-full bg-white/90 backdrop-blur-xl border-b border-neutral-200/60 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Brand -->
      <a href="/" class="flex items-baseline gap-2 shrink-0">
        <span class="text-xl sm:text-2xl font-bold font-serif tracking-tight text-forest-950 leading-none">
          Bauer
        </span>
        <span class="text-[10px] sm:text-[11px] font-semibold tracking-widest text-forest-600 uppercase leading-none">
          Psicólogo
        </span>
      </a>

      <!-- Desktop Nav (centered) -->
      <nav class="hidden lg:flex items-center gap-1 mx-auto" aria-label="Principal">
        {navLinks.map((link) => (
          <a
            class="text-sm font-medium text-neutral-600 hover:text-forest-900 hover:bg-forest-50 px-3.5 py-2 rounded-lg transition-all"
            href={link.href}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right: CTA + Mobile toggle -->
      <div class="flex items-center gap-3 shrink-0">
        <a
          href="#agendamento"
          class="bg-forest-900 hover:bg-forest-800 text-white text-xs sm:text-sm font-semibold px-4 sm:px-5 py-2.5 rounded-full transition-colors flex items-center gap-2"
        >
          <Send class="w-3.5 h-3.5 text-accent-lime shrink-0" />
          <span class="hidden sm:inline">Agendar Sessão</span>
          <span class="sm:hidden">Agendar</span>
        </a>

        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Abrir menu de navegação"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="lg:hidden p-2 rounded-xl text-neutral-700 hover:bg-neutral-100 transition-colors"
        >
          <Menu id="menu-icon-open" class="w-5 h-5 block" />
          <X id="menu-icon-close" class="w-5 h-5 hidden" />
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-neutral-100 px-6 py-4 shadow-lg">
    <nav class="flex flex-col gap-0.5 text-base font-medium text-neutral-700" aria-label="Menu mobile">
      {navLinks.map((link) => (
        <a class="mobile-link py-3 px-3 hover:text-forest-900 hover:bg-forest-50 rounded-lg transition-colors" href={link.href}>{link.label}</a>
      ))}
      <div class="pt-3 mt-2 border-t border-neutral-100">
        <a
          href="#agendamento"
          class="mobile-link w-full bg-forest-900 text-white text-sm font-semibold py-3 px-4 rounded-xl flex items-center justify-center gap-2"
        >
          <Send class="w-4 h-4 text-accent-lime" />
          <span>Agendar Sessão</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Fechar menu de navegação' : 'Abrir menu de navegação');
  };

  btn?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') ?? false);
  });

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => setOpen(false));
  });
</script>
