---
import { MessageCircle, Menu, X } from 'lucide-astro';
import { whatsappUrl } from '../data/site';

const headerWhatsappUrl = whatsappUrl("Olá, Psicólogo Bauer! Gostaria de agendar uma primeira sessão de psicoterapia.");

const navLinks = [
  { href: "#sobre", label: "Sobre" },
  { href: "#modalidades", label: "Atendimentos" },
  { href: "#podcast", label: "Podcast" },
  { href: "#depoimentos", label: "Depoimentos" },
  { href: "#faq", label: "Dúvidas" },
];
---

<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-neutral-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-[1fr_auto] lg:grid-cols-[auto_1fr_auto] items-center h-16 gap-4">
      <a href="/" class="flex items-baseline gap-2 min-w-0 justify-self-start">
        <span class="text-2xl font-bold font-serif tracking-tight text-forest-950 leading-none">
          Bauer
        </span>
        <span class="text-[11px] font-medium tracking-wide text-forest-700 uppercase whitespace-nowrap">
          Psicólogo
        </span>
      </a>

      <nav class="hidden lg:flex items-center justify-center gap-6 text-sm font-medium text-neutral-600 whitespace-nowrap" aria-label="Principal">
        {navLinks.map((link) => (
          <a class="hover:text-forest-900 transition-colors" href={link.href}>{link.label}</a>
        ))}
      </nav>

      <div class="flex items-center justify-end gap-2">
        <a
          href={headerWhatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-forest-900 hover:bg-forest-800 text-white text-sm font-medium px-4 py-2 rounded-full transition-colors flex items-center gap-2 whitespace-nowrap"
        >
          <MessageCircle class="w-4 h-4 text-accent-lime shrink-0" />
          <span class="hidden sm:inline">WhatsApp</span>
        </a>

        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Abrir menu de navegação"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="lg:hidden p-2 rounded-xl text-neutral-800 hover:bg-neutral-100"
        >
          <Menu id="menu-icon-open" class="w-6 h-6 block" />
          <X id="menu-icon-close" class="w-6 h-6 hidden" />
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-neutral-100 px-6 py-5">
    <nav class="flex flex-col gap-1 text-base font-medium text-neutral-700" aria-label="Menu mobile">
      {navLinks.map((link) => (
        <a class="mobile-link py-2.5 hover:text-forest-900" href={link.href}>{link.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Fechar menu de navegação' : 'Abrir menu de navegação');
  };

  btn?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') ?? false);
  });

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => setOpen(false));
  });
</script>
